{
  "name": "rune-tactics-pvp-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/index.js && npm run build:mcp",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --pool=threads --poolOptions.threads.singleThread",
    "start": "node dist/index.js",
    "mcp": "node dist/mcp/cli.js",
    "build:mcp": "esbuild src/mcp/cli.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/mcp/cli.js"
  },
  "dependencies": {
    "dotenv": "^18.0.10",
    "@colyseus/schema": "5.0.49",
    "@colyseus/sdk": "^0.18.10",
    "@colyseus/ws-transport": "^0.18.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "colyseus": "0.18.12",
    "express": "^4.22.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^22.10.0",
    "esbuild": "^0.25.12",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
