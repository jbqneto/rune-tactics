# Colyseus HTTP and WebSocket listener (Coolify / Docker should expose this port).
PORT=2567

# Shared HMAC-SHA256 secret for PvP player and MCP agent session authentication.
# CRITICAL: Colyseus server and MCP stdio process MUST share the exact same secret
# so that MCP-generated session tokens can be validated by the Colyseus backend (avoiding 401).
# - Local development: automatically loaded from repository root .env by both the
#   Colyseus server and MCP CLI (e.g. PVP_SESSION_SECRET=local-dev-pvp-secret).
# - Production: configure via host/container environment secrets (e.g.: openssl rand -hex 32).
#   Startup fails fast in production (NODE_ENV=production or ENVIRONMENT=production) if omitted.
# - SECURITY: Never prefix with VITE_ (avoids client bundle leakage) and never commit .env to Git.
PVP_SESSION_SECRET=

# Optional comma-separated browser origins, e.g. https://play.example.com,http://localhost:5173
# Same-origin requests are always allowed. When empty outside production, loopback origins
# (http://localhost:*, http://127.0.0.1:*) are also allowed so the Vite dev client works.
# In production, list every cross-origin frontend explicitly.
ALLOWED_ORIGINS=

# Optional frontend override for development. Leave empty for same-origin production.
# Example: http://localhost:2567
VITE_PVP_SERVER_URL=
