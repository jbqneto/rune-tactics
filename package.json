{
  "name": "rune-tactics",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "npm --prefix server run dev",
    "start:server": "npm --prefix server run start",
    "build": "tsc --noEmit && vite build",
    "build:server": "npm --prefix server run build",
    "build:all": "npm run build && npm run build:server",
    "typecheck": "tsc --noEmit",
    "typecheck:server": "npm --prefix server run typecheck",
    "typecheck:all": "npm run typecheck && npm run typecheck:server",
    "test": "vitest run",
    "test:server": "npm --prefix server run test",
    "test:all": "npm run test && npm run test:server",
    "mcp": "npm --prefix server run mcp",
    "build:mcp": "npm --prefix server run build:mcp"
  },
  "dependencies": {
    "@colyseus/sdk": "0.18.10",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@types/three": "^0.170.0",
    "typescript": "^5.6.3",
    "vite": "^6.0.0",
    "vitest": "^2.1.4"
  }
}
